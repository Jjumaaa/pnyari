# Copy to .env.local (never commit real values).

# Public URL of the deployed site — used for canonical links, Open Graph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.org

# YouTube Data API v3 key (server-side only). Without it, the site shows the saved sermons in data/sermons.js.
# Create in Google Cloud Console → enable "YouTube Data API v3" → Credentials → API key.
# Restrict the key to the YouTube Data API v3.
YOUTUBE_API_KEY=

# Optional. Defaults to the official @PCEANyariChurch channel.
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# YOUTUBE_CHANNEL_HANDLE=@PCEANyariChurch

# Optional. Show only one playlist (e.g. a "Sermons" playlist) instead of all channel uploads.
# YOUTUBE_PLAYLIST_ID=PLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
